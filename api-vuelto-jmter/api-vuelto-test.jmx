          <stringProp name="variableNames">merchantId,secretKey,destinationId,destinationMobile,originMobile</stringProp>
        </CSVDataSet>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="request">
          <stringProp name="HTTPSampler.domain">apimbu.mercantilbanco.com</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/mercantil-banco/sandbox/v1/payment/c2p</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;merchant_identify&quot;: {&#xd;
    &quot;integratorId&quot;: &quot;31&quot;,&#xd;
    &quot;merchantId&quot;: &quot;${merchantId}&quot;,&#xd;
    &quot;terminalId&quot;: &quot;abcde&quot;&#xd;
  },&#xd;
  &quot;client_identify&quot;: {&#xd;
    &quot;ipaddress&quot;: &quot;127.0.0.1&quot;,&#xd;
    &quot;browser_agent&quot;: &quot;&quot;,&#xd;
    &quot;mobile&quot;: {&#xd;
      &quot;manufacturer&quot;: &quot;&quot;,&#xd;
      &quot;model&quot;: &quot;&quot;,&#xd;
      &quot;os_version&quot;: &quot;&quot;,&#xd;
      &quot;location&quot;: {&#xd;
        &quot;lat&quot;: 0,&#xd;
        &quot;lng&quot;: 0&#xd;
      }&#xd;
    }&#xd;
  },&#xd;
  &quot;transaction_c2p&quot;: {&#xd;
    &quot;amount&quot;: 10,&#xd;
    &quot;currency&quot;: &quot;ves&quot;,&#xd;
    &quot;destination_bank_id&quot;: &quot;105&quot;,&#xd;
    &quot;destination_id&quot;: &quot;${encryptedDestinationId}&quot;,&#xd;
    &quot;destination_mobile_number&quot;: &quot;${encryptedDestinationMobile}&quot;,&#xd;
    &quot;payment_reference&quot;: &quot;&quot;,&#xd;
    &quot;origin_mobile_number&quot;: &quot;${encryptedOriginMobile}&quot;,&#xd;
    &quot;trx_type&quot;: &quot;vuelto&quot;,&#xd;
    &quot;payment_method&quot;: &quot;p2p&quot;,&#xd;
    &quot;invoice_number&quot;: &quot;${invoiceNumber}&quot;&#xd;
  }&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.SecretKeySpec
import java.security.MessageDigest

// ── Función de encriptado AES-128-ECB ──
def encrypt(String message, String key) {
    def digest = MessageDigest.getInstance(&quot;SHA-256&quot;)
    digest.update(key.bytes)
    def fullHash = digest.digest().encodeHex().toString()
    def firstHalf = fullHash.substring(0, (int)(fullHash.length() / 2))
    def keyBytes = firstHalf.decodeHex()

    def cipher = Cipher.getInstance(&quot;AES/ECB/PKCS5Padding&quot;)
    cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(keyBytes, &quot;AES&quot;))
    def encrypted = cipher.doFinal(message.bytes)
    return encrypted.encodeBase64().toString()
}

// ── Leer variables del CSV ──
def secretKey      = vars.get(&quot;secretKey&quot;)
def destinationId  = vars.get(&quot;destinationId&quot;)
def destMobile     = vars.get(&quot;destinationMobile&quot;)
def originMobile   = vars.get(&quot;originMobile&quot;)

// ── Encriptar campos ──
vars.put(&quot;encryptedDestinationId&quot;,     encrypt(destinationId, secretKey))
vars.put(&quot;encryptedDestinationMobile&quot;, encrypt(destMobile, secretKey))
vars.put(&quot;encryptedOriginMobile&quot;,      encrypt(originMobile, secretKey))

// ── Generar invoice_number aleatorio de 10 dígitos ──
def invoice = String.format(&quot;%010d&quot;, new Random().nextInt(1000000000))
vars.put(&quot;invoiceNumber&quot;, invoice)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
