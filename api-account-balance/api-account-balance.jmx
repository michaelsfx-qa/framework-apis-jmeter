        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.SecretKeySpec
import javax.crypto.spec.GCMParameterSpec
import java.security.MessageDigest
import java.security.SecureRandom

// ── Limpiar flag de PDF solo en el primer thread del primer loop ──
if (ctx.getThreadNum() == 0 &amp;&amp; vars.getIteration() == 1) {
    props.remove(&quot;pdfGenerated&quot;)
    props.remove(&quot;allResults&quot;)
}

// ── Función de encriptado AES-128-GCM ──
def encrypt(String plainText, String key) {
    def digest = MessageDigest.getInstance(&quot;SHA-256&quot;)
    digest.update(key.bytes)
    def fullHash = digest.digest().encodeHex().toString()
    def firstHalf = fullHash.substring(0, (int)(fullHash.length() / 2))
    def keyBytes = firstHalf.decodeHex()

    def iv = new byte[12]
    new SecureRandom().nextBytes(iv)

    def cipher = Cipher.getInstance(&quot;AES/GCM/NoPadding&quot;)
    cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(keyBytes, &quot;AES&quot;), new GCMParameterSpec(128, iv))
    def encrypted = cipher.doFinal(plainText.bytes)

    def result = new byte[iv.length + encrypted.length]
    System.arraycopy(iv, 0, result, 0, iv.length)
    System.arraycopy(encrypted, 0, result, iv.length, encrypted.length)

    return result.encodeBase64().toString()
}

// ── Leer variables del CSV ──
def testId     = vars.get(&quot;testId&quot;)
def rif        = vars.get(&quot;Rif&quot;)
def secretKey  = vars.get(&quot;secretKey&quot;)
def customerId = vars.get(&quot;customerId&quot;)

// ── Encriptar campos ──
def encryptedCustomerId = encrypt(customerId, secretKey)
vars.put(&quot;encryptedCustomerId&quot;, encryptedCustomerId)

// ── Validar que no hay datos vacíos o mezclados ──
def allOk = testId != null &amp;&amp; rif != null &amp;&amp; secretKey != null &amp;&amp; customerId != null &amp;&amp;
            !testId.isEmpty() &amp;&amp; !rif.isEmpty() &amp;&amp; !secretKey.isEmpty() &amp;&amp; !customerId.isEmpty()

vars.put(&quot;dataValidation&quot;, allOk ? &quot;OK&quot; : &quot;ERROR&quot;)

// ── Capturar el REQUEST para el PDF ──
def requestBody = &quot;&quot;&quot;{
  &quot;merchantIdentify&quot;: {
    &quot;integratorId&quot;: &quot;31&quot;,
    &quot;merchantId&quot;: &quot;${rif}&quot;,
    &quot;terminalId&quot;: &quot;abcde&quot;
  },
  &quot;clientIdentify&quot;: {
    &quot;ipAddress&quot;: &quot;127.0.0.1&quot;,
    &quot;browserAgent&quot;: &quot;Chrome 18.1.3&quot;,
    &quot;mobile&quot;: {}
  },
  &quot;customerInfo&quot;: {
    &quot;customerId&quot;: &quot;${encryptedCustomerId}&quot;
  }
}&quot;&quot;&quot;

vars.put(&quot;requestBody&quot;, requestBody)

log.info(&quot;PreProcessor OK - testId: ${testId} | Rif: ${rif} | dataValidation: ${vars.get(&apos;dataValidation&apos;)}&quot;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-IBM-Client-Id</stringProp>
                <stringProp name="Header.value">95022ad83ea2c5be8a1fe6a667a9b1ef</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// ── Capturar el RESPONSE y HTTP Status Code ──
def responseCode   = prev.getResponseCode()
def responseBody   = prev.getResponseDataAsString()
def testId         = vars.get(&quot;testId&quot;)
def dataValidation = vars.get(&quot;dataValidation&quot;)

// ── Determinar estado ──
def isHttpSuccess = responseCode != null &amp;&amp; responseCode.startsWith(&quot;2&quot;)
def isDataOk      = dataValidation == &quot;OK&quot;
def status        = (isHttpSuccess &amp;&amp; isDataOk) ? &quot;EXITOSO&quot; : &quot;FALLIDO&quot;

// ── Guardar en variables para el PDF ──
vars.put(&quot;responseCode&quot;, responseCode)
vars.put(&quot;responseBody&quot;, responseBody)
vars.put(&quot;testStatus&quot;,   status)

// ── Guardar datos de este thread en lista compartida ──
def threadData = [
    testId        : testId,
    endpoint      : &quot;POST http://10.7.0.123:5002/payment/account-balance&quot;,
    requestBody   : vars.get(&quot;requestBody&quot;),
    responseCode  : responseCode,
    responseBody  : responseBody,
    dataValidation: dataValidation,
    status        : status
]

synchronized(props) {
    def allResults = props.get(&quot;allResults&quot;)
    if (allResults == null) {
        allResults = []
        props.put(&quot;allResults&quot;, allResults)
    }
    allResults.add(threadData)
}

log.info(&quot;PostProcessor OK - testId: ${testId} | HTTP: ${responseCode} | Estado: ${status}&quot;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
