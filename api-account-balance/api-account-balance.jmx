      </hashTree>
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown Thread Group" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import com.lowagie.text.*
import com.lowagie.text.pdf.*
import java.time.LocalDateTime
import java.time.format.DateTimeFormatter

// ── Obtener todos los resultados acumulados ──
def allResults = props.get(&quot;allResults&quot;)
if (allResults == null || allResults.isEmpty()) {
    log.info(&quot;No hay resultados para generar PDF&quot;)
    return
}

// ── Contar exitosos y fallidos ──
def totalExitosos = allResults.count { it.status == &quot;EXITOSO&quot; }
def totalFallidos = allResults.count { it.status == &quot;FALLIDO&quot; }

// ── Configurar PDF ──
def fecha = LocalDateTime.now().format(DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd_HH-mm-ss&quot;))
def pdfPath = &quot;C:/Users/C611125/Documents/framework-apis-jmeter/api-account-balance/evidencia-${fecha}.pdf&quot;

def document = new Document(PageSize.A4, 36, 36, 36, 36)
PdfWriter.getInstance(document, new FileOutputStream(pdfPath))
document.open()

// ── Fuentes ──
def fontTitulo      = new Font(Font.HELVETICA, 22, Font.BOLD)
def fontSubtitulo   = new Font(Font.HELVETICA, 13, Font.BOLD)
def fontNormal      = new Font(Font.HELVETICA, 10, Font.NORMAL)
def fontSmall       = new Font(Font.HELVETICA, 7, Font.NORMAL)
def fontCode        = new Font(Font.COURIER, 6, Font.NORMAL)
def fontExitoso     = new Font(Font.HELVETICA, 8, Font.BOLD, new java.awt.Color(0, 128, 0))
def fontFallido     = new Font(Font.HELVETICA, 8, Font.BOLD, new java.awt.Color(255, 0, 0))
def fontExitosoGrande = new Font(Font.HELVETICA, 13, Font.BOLD, new java.awt.Color(0, 128, 0))
def fontFallidoGrande = new Font(Font.HELVETICA, 13, Font.BOLD, new java.awt.Color(255, 0, 0))
def fontGris        = new Font(Font.HELVETICA, 10, Font.NORMAL, new java.awt.Color(100, 100, 100))

// ── PORTADA ──
// Espacios para centrar verticalmente
(1..8).each { document.add(new Paragraph(&quot; &quot;)) }

def titlePara = new Paragraph(&quot;REPORTE DE PRUEBAS DE CONCURRENCIA&quot;, fontTitulo)
titlePara.setAlignment(Element.ALIGN_CENTER)
document.add(titlePara)

document.add(new Paragraph(&quot; &quot;))

def subtitlePara = new Paragraph(&quot;API Account Balance&quot;, fontSubtitulo)
subtitlePara.setAlignment(Element.ALIGN_CENTER)
document.add(subtitlePara)

document.add(new Paragraph(&quot; &quot;))
document.add(new Paragraph(&quot; &quot;))

def lineaPara = new Paragraph(&quot;─────────────────────────────────────────────────────────────&quot;, fontSmall)
lineaPara.setAlignment(Element.ALIGN_CENTER)
document.add(lineaPara)

document.add(new Paragraph(&quot; &quot;))

def fechaLegible = LocalDateTime.now().format(DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd HH:mm:ss&quot;))
def fechaPara = new Paragraph(&quot;Fecha de ejecucion: ${fechaLegible}&quot;, fontNormal)
fechaPara.setAlignment(Element.ALIGN_CENTER)
document.add(fechaPara)

document.add(new Paragraph(&quot; &quot;))

def totalPara = new Paragraph(&quot;Total de casos ejecutados: ${allResults.size()}&quot;, fontNormal)
totalPara.setAlignment(Element.ALIGN_CENTER)
document.add(totalPara)

document.add(new Paragraph(&quot; &quot;))

def exitPara = new Paragraph(&quot;Exitosos: ${totalExitosos}&quot;, fontExitosoGrande)
exitPara.setAlignment(Element.ALIGN_CENTER)
document.add(exitPara)

def failPara = new Paragraph(&quot;Fallidos: ${totalFallidos}&quot;, fontFallidoGrande)
failPara.setAlignment(Element.ALIGN_CENTER)
document.add(failPara)

document.add(new Paragraph(&quot; &quot;))
document.add(lineaPara)

document.add(new Paragraph(&quot; &quot;))
def endpointPara = new Paragraph(&quot;Endpoint: POST http://10.7.0.123:5002/payment/account-balance&quot;, fontGris)
endpointPara.setAlignment(Element.ALIGN_CENTER)
document.add(endpointPara)

// ── Una hoja por cada caso ──
allResults.eachWithIndex { result, index -&gt;

    document.add(Chunk.NEXTPAGE)

    document.add(new Paragraph(&quot;─────────────────────────────────────────────────────────────&quot;, fontSmall))
    document.add(new Paragraph(&quot;Caso: ${result.testId}&quot;, new Font(Font.HELVETICA, 8, Font.BOLD)))
    document.add(new Paragraph(&quot;Endpoint: ${result.endpoint}&quot;, fontSmall))
    document.add(new Paragraph(&quot; &quot;))

    document.add(new Paragraph(&quot;REQUEST:&quot;, new Font(Font.HELVETICA, 8, Font.BOLD)))
    document.add(new Paragraph(result.requestBody, fontCode))
    document.add(new Paragraph(&quot; &quot;))

    document.add(new Paragraph(&quot;RESPONSE:&quot;, new Font(Font.HELVETICA, 8, Font.BOLD)))
    document.add(new Paragraph(&quot;HTTP Status: ${result.responseCode}&quot;, fontSmall))
    document.add(new Paragraph(result.responseBody, fontCode))
    document.add(new Paragraph(&quot; &quot;))

    def validacionTexto = result.dataValidation == &quot;OK&quot; ? &quot;OK - Sin mezcla de datos&quot; : &quot;ERROR - Datos vacios o mezclados&quot;
    document.add(new Paragraph(&quot;Validacion de datos: ${validacionTexto}&quot;, fontSmall))

    def estadoFont  = result.status == &quot;EXITOSO&quot; ? fontExitoso : fontFallido
    def estadoTexto = result.status == &quot;EXITOSO&quot; ? &quot;EXITOSO&quot; : &quot;FALLIDO&quot;
    document.add(new Paragraph(&quot;Estado: ${estadoTexto}&quot;, estadoFont))
    document.add(new Paragraph(&quot;─────────────────────────────────────────────────────────────&quot;, fontSmall))
}

document.close()

// ── Limpiar para proxima ejecucion ──
props.remove(&quot;allResults&quot;)
props.remove(&quot;pdfGenerated&quot;)

log.info(&quot;PDF generado con ${allResults.size()} casos: ${pdfPath}&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
